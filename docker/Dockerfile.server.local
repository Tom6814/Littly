FROM golang:1.26.10-alpine AS build
WORKDIR /build
RUN apk add --no-cache git make
ENV GOPROXY=https://goproxy.cn,direct GOSUMDB=off
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=arm64 go build -trimpath -o memoh-server ./cmd/agent \
 && CGO_ENABLED=0 GOOS=linux GOARCH=arm64 go build -trimpath -o memoh-channel ./cmd/channel \
 && CGO_ENABLED=0 GOOS=linux GOARCH=arm64 go build -trimpath -o /out-bridge ./cmd/bridge

FROM alpine:latest
WORKDIR /app
RUN apk add --no-cache containerd containerd-ctr
RUN apk add --no-cache ca-certificates tzdata wget cni-plugins iptables \
      gstreamer-tools gst-plugins-base gst-plugins-good gst-plugins-bad gst-plugins-ugly \
    && mkdir -p /opt/cni/bin \
    && (cp -a /usr/lib/cni/. /opt/cni/bin/ 2>/dev/null || true) \
    && (cp -a /usr/libexec/cni/. /opt/cni/bin/ 2>/dev/null || true) \
    && mkdir -p /etc/cni/net.d /var/lib/cni \
    && printf '%s\n' \
      '{' \
      '  "cniVersion": "1.0.0",' \
      '  "name": "memoh-cni",' \
      '  "plugins": [' \
      '    {' \
      '      "type": "bridge",' \
      '      "bridge": "cni0",' \
      '      "isGateway": true,' \
      '      "ipMasq": true,' \
      '      "hairpinMode": true,' \
      '      "ipam": {' \
      '        "type": "host-local",' \
      '        "ranges": [[' \
      '          { "subnet": "10.88.0.0/16" }' \
      '        ]],' \
      '        "routes": [' \
      '          { "dst": "0.0.0.0/0" }' \
      '        ]' \
      '      }' \
      '    },' \
      '    {' \
      '      "type": "portmap",' \
      '      "capabilities": { "portMappings": true }' \
      '    }' \
      '  ]' \
      '}' > /etc/cni/net.d/10-memoh.conflist
COPY --from=build /out-bridge /opt/memoh/runtime/bridge
COPY --from=build /build/memoh-server /app/memoh-server
COPY --from=build /build/memoh-channel /app/memoh-channel
COPY --from=build /build/spec /app/spec
COPY --from=build /build/conf/providers /app/conf/providers
COPY docker/server-entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh && mkdir -p /opt/memoh/data /run/containerd /var/lib/containerd
VOLUME ["/var/lib/containerd", "/opt/memoh/data"]
EXPOSE 8080 8081 9090 9091 1455
HEALTHCHECK --interval=15s --timeout=3s --start-period=40s --retries=20 \
    CMD wget --no-verbose --tries=1 --spider http://127.0.0.1:8080/health || exit 1
ENTRYPOINT ["/entrypoint.sh"]
