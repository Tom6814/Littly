# Littly UI only: the old Littly console is prebuilt into docker/littly-console.
# The upstream Memoh web app is intentionally NOT built or served anymore.
FROM nginx:alpine
COPY docker/littly-console /usr/share/nginx/html/littly
ENV MEMOH_SERVER_UPSTREAM=memoh-server:8080 MEMOH_CHANNEL_UPSTREAM=memoh-channel:8081
COPY docker/nginx.conf /etc/nginx/templates/default.conf.template
COPY docker/nginx-app.conf /etc/nginx/templates/includes/memoh-app.conf.template
EXPOSE 8082
CMD ["nginx", "-g", "daemon off;"]
